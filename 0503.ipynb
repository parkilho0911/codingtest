     "output_type": "stream",
     "text": [
      "14\n"
     ]
    }
   ],
   "source": [
    "n, k = map(int, input().split())\n",
    "result = 0\n",
    "\n",
    "while True:\n",
    "    target = (n//k)*k\n",
    "    result +=(n -target)\n",
    "    n = target\n",
    "\n",
    "    if n<k:\n",
    "        break\n",
    "\n",
    "    result +=1\n",
    "    n//=k\n",
    "\n",
    "result +=(n-1)\n",
    "print(result)\n"
   ]
  }
 ],
